{
  "name": "@curatelabs/xyg-node",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./charts": "./src/charts.js",
    "./graph": "./src/graph.js",
    "./vscode": "./src/vscode.js"
  },
  "scripts": {
    "test": "node --test test/graph.test.mjs test/composition.test.mjs test/marks.test.mjs test/coverage.test.mjs test/pyramid.test.mjs test/stream.test.mjs test/scene.test.mjs test/no_browser_globals.test.mjs test/native-path.test.mjs test/html.test.mjs test/vscode_contract.test.mjs test/temporal.test.mjs",
    "golden:circle": "node scripts/circle_layout_golden.mjs",
    "golden:marks": "node scripts/mark_parity_golden.mjs",
    "fixtures:marks": "python3 test/fixtures/write_mark_fixtures.py"
  },
  "dependencies": {
    "koffi": "^3.1.4"
  },
  "optionalDependencies": {
    "@curatelabs/xyg-node-darwin-arm64": "file:../xyg-node-darwin-arm64",
    "@curatelabs/xyg-node-darwin-x64": "file:../xyg-node-darwin-x64",
    "@curatelabs/xyg-node-linux-arm64": "file:../xyg-node-linux-arm64",
    "@curatelabs/xyg-node-linux-x64": "file:../xyg-node-linux-x64",
    "@curatelabs/xyg-node-win32-x64": "file:../xyg-node-win32-x64"
  }
}
