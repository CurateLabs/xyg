+        q: QuerySpec,
+        cursor: Option<QueryCursor>,
+        budget: QueryBudget,
+        reader: &mut R,
+        cancel: &mut impl FnMut() -> bool,
+        consumer: impl FnMut(FeatureView<'_>, FeatureRef) -> Result<()>,
