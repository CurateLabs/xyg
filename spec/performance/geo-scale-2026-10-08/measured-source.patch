+        let c = GeoColumn::from_descriptor(GeoDescriptor {
+            geometry: GeoGeometry::MultiPoint,
+            crs: GeoCrs::Epsg3857,
+            xy: &[19_900_000., 0., -19_900_000., 1.],
+            validity: &[1],
+            feature_ids: Some(&[u64::MAX]),
+            offsets0: &[0, 2],
+            offsets1: &[],
+            offsets2: &[],
