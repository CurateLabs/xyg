+    ));
+    assert_eq!(drive(member.0, 1, &f.chunks), [0, 1]);
+    let page = Handle(n64(&execute(&prepare(member.0)).unwrap(), 16));
+    let pagebytes = read_data(&request(23, page.0, 0, &[]), 128 << 20).unwrap();
+    assert_eq!(n64(&pagebytes, 32), 8);
