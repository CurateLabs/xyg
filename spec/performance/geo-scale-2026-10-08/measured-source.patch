+        let requests = cache.requests().to_vec();
+        for request in requests {
+            let mut read = cache.start_read(request.ticket).unwrap();
+            for rgba in read.bytes_mut().chunks_exact_mut(4) {
+                rgba.copy_from_slice(&[1, 2, 3, 128]);
+            }
+            cache
