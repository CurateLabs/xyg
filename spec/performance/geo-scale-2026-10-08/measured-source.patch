+        })
+        .unwrap();
+        let t = GeoIntervals {
+            starts: &[i64::MIN],
+            ends: &[i64::MAX],
+            start_validity: &[1],
+            end_validity: &[1],
+        };
+        let b = GeoChunk::encode(&c, Some(t)).unwrap();
+        let chunk = GeoChunk::parse(&b, MAX_CHUNK_PEAK).unwrap();
+        let f = chunk.rows().next().unwrap();
+        let bounds = f.bounds().unwrap();
+        assert_eq!(
