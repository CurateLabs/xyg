+                return Err(SourceError::ResourceLimit);
+            }
+            let chunk = self.read_chunk(index, reader, cancel, peak)?;
+            stats.chunks_read += 1;
+            stats.bytes_read += c.encoded_bytes as u64;
+            stats.rows_examined += c.rows as u64;
