+    assert!(matches!(
+        read_data(&request(23, baseline_snapshot._handle.0, 0, &[]), 128 << 20),
+        Err(SourceError::ResourceLimit)
+    ));
+    assert!(matches!(
+        execute(&request(6, session.0, 0, &[])),
+        Err(SourceError::StaleSource)
+    ));
