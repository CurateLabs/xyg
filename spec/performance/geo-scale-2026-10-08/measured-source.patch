+                    read,
+                    GeoTileData::Raster {
+                        width: 256,
+                        height: 256,
+                        length: TILE_DIM * TILE_DIM * 4,
+                    },
+                )
+                .unwrap();
+        }
+        cache.commit_frame(epoch).unwrap();
+    }
