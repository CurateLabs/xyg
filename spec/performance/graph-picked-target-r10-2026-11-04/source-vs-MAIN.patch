+            None,
+            query(seq + 1, rev, op, 0, action, p),
+            InteractionStatus::Budget,
+            0,
+        );
+    }
+    s.max_bytes = max;
+    capture(&mut s, &mut replay, query(seq + 1, rev, 0, 0, 1, None));
