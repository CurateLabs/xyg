+#[test]
+fn shared_receipt_lifetime_keeps_original_query_until_last_owner_drops() {
+    let mut s = session(&standard_doc());
+    let r = s.render(None).unwrap();
+    let point = r.paint.nodes[0].center;
+    let h = header(&s, 1);
+    let out = s.hover_at(h, point[0], point[1]).unwrap();
+    let receipt = out.pick.as_ref().unwrap();
+    assert_eq!(receipt.header, h);
+    assert!(receipt.target.is_some());
+    assert_eq!(receipt.operation, 0);
+    assert_eq!(receipt.action, 0);
+    let weak = Arc::downgrade(receipt);
+    assert_eq!(
+        weak.strong_count(),
+        2,
+        "returned outcome plus retained typed outcome"
+    );
+    let cloned = out.clone();
+    let retry = s.hover_at(h, point[0], point[1]).unwrap();
+    assert_eq!(retry, out);
+    assert_eq!(cloned, out);
+    assert!(Arc::ptr_eq(receipt, retry.pick.as_ref().unwrap()));
+    assert_eq!(weak.strong_count(), 4);
+    drop((out, cloned, retry));
+    assert_eq!(weak.strong_count(), 1, "only retained outcome remains");
+    let leave_header = header(&s, 2);
+    let leave = s.hover_leave(leave_header).unwrap();
+    assert!(
+        weak.upgrade().is_none(),
+        "replacing last outcome releases original receipt"
+    );
+    let receipt = leave.pick.as_ref().unwrap();
+    assert_eq!(receipt.header, leave_header);
+    assert_eq!(
+        (receipt.operation, receipt.action, receipt.member_count),
+        (0, 1, 0)
+    );
+    assert_eq!(receipt.target, None);
+    assert_eq!(receipt.source, None);
+    assert!(s.hover.nodes.is_empty());
+    let before = s.last_op.clone();
+    let stale = OpHeader {
+        stamp: Stamp {
+            render_revision: leave_header.stamp.render_revision + 1,
+            ..leave_header.stamp
+        },
+        op_seq: 3,
+    };
+    assert_eq!(s.hover_leave(stale), Err(InteractionStatus::Stale));
+    assert_eq!(s.last_op, before);
+    let cached = s.hover_leave(leave_header).unwrap();
+    assert_eq!(cached, leave);
+    assert!(Arc::ptr_eq(receipt, cached.pick.as_ref().unwrap()));
+    println!("logical two-Arc body/header/alignment allowance={} of existing 1024-byte slice of 4096-byte receipt reserve", 2 * (std::mem::size_of::<PickReceipt>() + 4 * std::mem::size_of::<usize>()));
+}
