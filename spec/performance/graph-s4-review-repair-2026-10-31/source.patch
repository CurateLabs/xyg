+        host.graph
+            .lock()
+            .unwrap()
+            .as_ref()
+            .unwrap()
+            .interaction_state()
+            .selection(),
+        &foreign
+    );
+    host.graph
+        .lock()
+        .unwrap()
+        .as_mut()
+        .unwrap()
+        .interaction_state_mut()
+        .clear();
+    s.execute(&clear, 0, None).unwrap(); // no premature sequence or delivery
