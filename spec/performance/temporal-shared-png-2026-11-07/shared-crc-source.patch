diff --git a/crates/xyg-engine/Cargo.toml b/crates/xyg-engine/Cargo.toml
index 713ea179bc2c7e325d1695aa2217e2d312caf74d..eb7af34030309c7fd94d18d4860e1c00effa436d 100644
--- a/crates/xyg-engine/Cargo.toml
+++ b/crates/xyg-engine/Cargo.toml
@@ -11,16 +11,18 @@ name = "xyg_engine"
 
 [features]
 # Native hosts keep the complete raster/PNG exporter. The direct-browser WASM
-# adapter disables defaults so browser compute does not carry an unused PNG
-# encoder or the baked raster font atlas.
+# adapter disables defaults and admits only the chromeless retained raster
+# capability; the same renderer/PNG encoder can dead strip unused native formats.
 default = ["raster"]
 raster = ["dep:png", "dep:flate2"]
+# Same raster/PNG implementation, restricted to retained paint command capabilities.
+frozen-raster = ["dep:png"]
 
 # Static chart export uses the focused `png` crate's fdeflate fast path;
 # compression belongs beside rasterization so the hot path never round-trips
 # a full framebuffer through a host language. PDF FlateDecode streams use the
 # already-locked `flate2` (miniz_oxide) crate so native PDF needs no crates.io
-# fetch; WASM keeps default-features off and does not carry either encoder.
+# fetch. WASM retains the shared PNG capability, without native PDF/JPEG/WebP.
 [dependencies]
 png = { version = "0.18.1", optional = true }
 flate2 = { version = "1.1.9", optional = true, default-features = false, features = ["rust_backend"] }
